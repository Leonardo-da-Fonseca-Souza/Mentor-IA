# ==============================================================================
# Starter Kit: Variáveis de Ambiente e Configurações de IA
# ==============================================================================

# Chave de API do Google Gemini (Obter no Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo Padrão de LLM para Orquestração e Classificação
DEFAULT_LLM_MODEL=gemini-2.0-flash

# Modelo Padrão de LLM para Resumos e Síntese Jornalística
SYNTHESIS_LLM_MODEL=gemini-1.5-pro

# Limite Global de Requisições por Minuto (Throttling FinOps)
MAX_REQUESTS_PER_MINUTE=60

# Nível de Log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
