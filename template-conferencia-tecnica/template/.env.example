# ── GOOGLE CLOUD & GEMINI API CONFIGURATION ──────────────────────────
# Seu ID de projeto no Google Cloud Platform
GOOGLE_CLOUD_PROJECT=meu-projeto-gcp-2026

# Região para alocação de recursos da Vertex AI / Cloud Run
GOOGLE_CLOUD_REGION=southamerica-east1

# Caminho para a chave da Conta de Serviço (Service Account JSON)
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/chave-sa.json

# ── VERTEX AI / AGENT DEVELOPMENT KIT (ADK) ─────────────────────────
# Modelo LLM padronizado para execução dos agentes
ADK_MODEL=gemini-3.5-flash

# Nome da aplicação agêntica para observabilidade no Cloud Trace
ADK_APP_NAME=mentor-ia-starter-kit

# ── FINOPS & GOVERNANÇA ──────────────────────────────────────────────
# Budget máximo de tokens permitido por sessão de conversa
FINOPS_MAX_TOKENS_PER_SESSION=8000

# Limite de requisições por hora por IP (Throttling)
FINOPS_MAX_REQUESTS_PER_HOUR=500

# ── LOGGING E OBSERVABILIDADE ────────────────────────────────────────
# Nível de detalhes dos logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
