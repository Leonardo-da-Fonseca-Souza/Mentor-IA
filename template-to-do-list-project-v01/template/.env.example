# ── Google AI / Gemini API Keys ──────────────────────────────
# Adicione sua API key obtida no Google AI Studio (https://aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# ── Seleção de Modelos ──────────────────────────────────────
# Modelos recomendados: gemini-3.5-flash (rápido/econômico) e gemini-3.5-pro (análise)
GEMINI_MODEL_ORCHESTRATOR=gemini-3.5-flash
GEMINI_MODEL_WORKER=gemini-3.5-flash

# ── Limites FinOps & Governança ──────────────────────────────
MAX_TOKENS_PER_CALL=8192
MAX_TOKENS_PER_SESSION=65536
DAILY_BUDGET_USD=5.00
